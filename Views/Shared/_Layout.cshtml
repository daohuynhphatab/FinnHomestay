<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finn Homestay</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Google Fonts: 'Playfair Display' (Heading) & 'Mulish' (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,300..900;1,300..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinnHomestay.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-cozy sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="fa-solid fa-house-chimney"></i></span>
                    <span>Finn Homestay</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars text-dark fs-5"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-compass me-1 text-muted"></i> Trang chủ
                            </a>
                        </li>

                        @* Menu Quản lý Phòng: Chỉ Admin hoặc Staff mới thấy *@
                        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                        {
                            <!-- Liên kết quản lý loại phòng dành cho Admin và Staff -->
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="RoomType" asp-action="Index">
                                    <i class="fa-solid fa-layer-group me-1 text-muted"></i> Quản lý Loại phòng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Room" asp-action="Index">
                                    <i class="fa-solid fa-bed me-1 text-muted"></i> Quản lý Phòng
                                </a>
                            </li>
                        }

                        @* Menu Đơn đặt phòng *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Booking" asp-action="Index">
                                <i class="fa-solid fa-calendar-check me-1 text-muted"></i>
                                @(User.IsInRole("Customer") ? "Đơn đặt của tôi" : "Đơn đặt phòng")
                            </a>
                        </li>

                        @* Menu Quản lý Tài khoản: Chỉ Admin mới thấy *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="User" asp-action="Index">
                                    <i class="fa-solid fa-users-gear me-1 text-muted"></i> Quản lý Tài khoản
                                </a>
                            </li>
                        }
                    </ul>

                    @* Khu vực Xác thực người dùng (Login/Logout) *@
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-menu-btn d-inline-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user text-secondary fs-5"></i>
                                    <span>@User.Identity.Name</span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger rounded-pill">Admin</span>
                                    }
                                    else if (User.IsInRole("Staff"))
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">Staff</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill">Customer</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                                    <li><h6 class="dropdown-header text-muted">Tài khoản: @User.Identity.Name</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 py-2">
                                                <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link d-inline-flex align-items-center gap-1" asp-controller="Auth" asp-action="Login">
                                    <i class="fa-solid fa-key text-muted"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-cozy-primary d-inline-flex align-items-center gap-1 text-decoration-none" asp-controller="Auth" asp-action="Register">
                                    <i class="fa-solid fa-user-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* Kiểm tra xem View hiện tại có yêu cầu Full-Width (ví dụ Landing Page) hay không *@
    @if (ViewData["IsFullWidth"] as bool? == true)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container py-4">
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    }

    <!-- Footer cao cấp phong cách Modern & Cozy -->
    <footer class="footer-cozy">
        <div class="container">
            <div class="row g-4">
                <!-- Cột 1: Thông tin thương hiệu -->
                <div class="col-lg-4 col-md-6">
                    <h5>🏡 Finn Homestay</h5>
                    <p class="mt-3">
                        Finn Homestay mang đến không gian nghỉ dưỡng ấm cúng, tinh tế giữa lòng phố thị. Nơi lưu giữ những khoảnh khắc bình yên và mang lại cảm giác thân thuộc như chính ngôi nhà của bạn.
                    </p>
                    <div class="footer-social-icons">
                        <a href="#" class="footer-social-icon" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Khám phá -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Khám phá</h6>
                    <ul class="footer-links-list mt-3">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a href="#featured">Phòng nghỉ nổi bật</a></li>
                        <li><a href="#about">Về Finn Homestay</a></li>
                        <li><a href="#amenities">Tiện ích trải nghiệm</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Chính sách & Giờ giấc -->
                <div class="col-lg-3 col-md-6 col-6">
                    <h6>Quy định & Dịch vụ</h6>
                    <ul class="footer-links-list mt-3">
                        <li><i class="fa-regular fa-clock me-1 text-gold"></i> Nhận phòng: <strong>14:00</strong></li>
                        <li><i class="fa-regular fa-clock me-1 text-gold"></i> Trả phòng: <strong>12:00</strong></li>
                        <li><a href="#about">Chính sách đặt phòng</a></li>
                        <li><a href="#about">Hỗ trợ khách hàng 24/7</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Thông tin liên hệ -->
                <div class="col-lg-3 col-md-6">
                    <h6>Liên hệ</h6>
                    <div class="mt-3">
                        <div class="footer-contact-item">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>36 đường ven biển, Lại Sơn, An Giang</span>
                        </div>
                        <div class="footer-contact-item">
                            <i class="fa-solid fa-phone"></i>
                            <span><a href="tel:0766943051" class="text-reset text-decoration-none">0766943051</a></span>
                        </div>
                        <div class="footer-contact-item">
                            <i class="fa-solid fa-envelope"></i>
                            <span><a href="mailto:daohuynhphatab@gmail.com" class="text-reset text-decoration-none">daohuynhphatab@gmail.com</a></span>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="footer-divider" />

            <div class="footer-copyright">
                &copy; 2026 Finn Homestay - Hệ thống đặt phòng homestay sinh viên. Phát triển trên nền tảng ASP.NET Core MVC &amp; MySQL.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
