@model IEnumerable<FinnHomestay.Models.Room>

@{
    ViewData["Title"] = "Quản lý Phòng";
}

<style>
    .btn-action-room {
        width: 72px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 6px !important;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }
    .btn-action-room:hover {
        transform: translateY(-1px);
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">🏨 Quản lý Danh sách Phòng</h2>
        <p class="text-muted mb-0">Quản lý thông tin, giá phòng và trạng thái phòng tại Finn Homestay</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Thêm phòng mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Form tìm kiếm phòng -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" class="form-control" 
                       placeholder="Nhập tên phòng cần tìm kiếm..." 
                       value="@ViewData["CurrentFilter"]" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary">
                    🔍 Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách phòng -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">
                <p class="mb-0">Chưa có phòng nào hoặc không tìm thấy phòng phù hợp với từ khóa.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="text-center">Hình ảnh</th>
                            <th>Tên phòng</th>
                            <th>Mô tả</th>
                            <th>Giá / đêm</th>
                            <th class="text-center">Trạng thái</th>
                            <th style="width: 250px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="img-thumbnail" style="max-height: 50px; max-width: 70px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">No image</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.Name</div>
                                    @if (!string.IsNullOrEmpty(item.TiktokLink))
                                    {
                                        <a href="@item.TiktokLink" target="_blank" rel="noopener noreferrer" 
                                           class="badge bg-dark text-white text-decoration-none mt-1 d-inline-flex align-items-center gap-1"
                                           title="Xem video trên TikTok">
                                            <i class="fa-brands fa-tiktok text-info"></i> TikTok
                                        </a>
                                    }
                                </td>
                                <td class="text-muted text-truncate" style="max-width: 250px;">
                                    @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả" : item.Description)
                                </td>
                                <td class="text-success fw-bold">@item.Price.ToString("N0") VNĐ</td>
                                <td class="text-center">
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge bg-success">Còn trống</span>
                                    }
                                    else if (item.Status == "Occupied")
                                    {
                                        <span class="badge bg-danger">Đã đặt</span>
                                    }
                                    else if (item.Status == "Maintenance")
                                    {
                                        <span class="badge bg-warning text-dark">Bảo trì</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-sm btn-outline-secondary btn-action-room" 
                                           title="Xem chi tiết phòng">
                                            <i class="fa-solid fa-eye me-1"></i>Xem
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                           class="btn btn-sm btn-outline-primary btn-action-room" 
                                           title="Chỉnh sửa thông tin phòng">
                                            <i class="fa-solid fa-pen-to-square me-1"></i>Sửa
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng &quot;@item.Name&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-action-room" title="Xóa phòng">
                                                <i class="fa-solid fa-trash me-1"></i>Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
