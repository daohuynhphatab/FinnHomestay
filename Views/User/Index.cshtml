@model IEnumerable<FinnHomestay.Models.User>

@{
    ViewData["Title"] = "Quản lý Tài khoản Người dùng";
    var currentFilter = ViewData["CurrentFilter"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">👥 Quản lý Tài khoản (Admin)</h2>
        <p class="text-muted mb-0">Quản lý danh sách người dùng, phân quyền Admin, Staff và Customer</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Thêm tài khoản mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thanh tìm kiếm -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="searchString" class="form-control" 
                       placeholder="Nhập tên, email hoặc số điện thoại cần tìm..." 
                       value="@currentFilter" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary">
                    🔍 Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(currentFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách người dùng -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <h5 class="fw-normal">Không tìm thấy tài khoản nào</h5>
                <p class="mb-3">Không có tài khoản nào phù hợp với từ khóa tìm kiếm.</p>
                <a asp-action="Create" class="btn btn-sm btn-outline-primary">+ Thêm tài khoản mới</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;" class="text-center">#ID</th>
                            <th>Họ và tên</th>
                            <th>Địa chỉ Email</th>
                            <th>Số điện thoại</th>
                            <th class="text-center">Vai trò (Role)</th>
                            <th style="width: 190px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="text-center text-muted fw-semibold">#@user.Id</td>
                                <td class="fw-semibold">
                                    👤 @user.FullName
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @(string.IsNullOrEmpty(user.Phone) ? "<span class=\"text-muted\">Chưa có</span>" : user.Phone)
                                </td>
                                <td class="text-center">
                                    @switch (user.Role)
                                    {
                                        case "Admin":
                                            <span class="badge bg-danger px-3 py-2 rounded-pill">👑 Admin</span>
                                            break;
                                        case "Staff":
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">💼 Staff</span>
                                            break;
                                        case "Customer":
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">👤 Customer</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@user.Role</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@user.Id" 
                                           class="btn btn-sm btn-outline-primary btn-action-custom" 
                                           title="Sửa thông tin tài khoản">
                                            <i class="fa-solid fa-pen-to-square me-1"></i>Sửa
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline m-0 p-0"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản &quot;@user.FullName&quot; (#@user.Id)?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-action-custom" title="Xóa tài khoản">
                                                <i class="fa-solid fa-trash me-1"></i>Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
