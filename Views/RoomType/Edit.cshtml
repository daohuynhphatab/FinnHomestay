@model FinnHomestay.Models.RoomType
@{ ViewData["Title"] = "Chỉnh sửa loại phòng"; }
<div class="row justify-content-center"><div class="col-lg-8">
    <div class="mb-4"><h1 class="h2 fw-bold">Chỉnh sửa loại phòng</h1><p class="text-muted">Cập nhật thông tin hạng phòng: @Model.Name.</p></div>
    <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">
        <!-- Biểu mẫu cập nhật loại phòng -->
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()<input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Price" class="form-label"></label><div class="input-group"><input asp-for="Price" type="number" min="0" step="10000" class="form-control" /><span class="input-group-text">VNĐ/đêm</span></div><span asp-validation-for="Price" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" /></div>
            <div class="mb-3"><label asp-for="TiktokLink" class="form-label"></label><input asp-for="TiktokLink" class="form-control" /></div>
            <div class="mb-4"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea></div>
            <div class="d-flex flex-wrap justify-content-between gap-2"><a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Quay lại</a><button class="btn btn-primary rounded-pill px-4" type="submit">Lưu thay đổi</button></div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
