@{
    ViewData["Title"] = "Không có quyền truy cập (403)";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-5">
                <div class="display-1 text-danger mb-3">⛔</div>
                <h3 class="fw-bold text-danger mb-2">Truy cập bị từ chối (Access Denied)</h3>
                <p class="text-muted mb-4">
                    Tài khoản của bạn không có đủ thẩm quyền để truy cập vào chức năng hoặc trang này. Chức năng này yêu cầu quyền <strong>Admin</strong> hoặc <strong>Staff</strong>.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        ← Về trang chủ
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">
                        Đăng nhập bằng tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
