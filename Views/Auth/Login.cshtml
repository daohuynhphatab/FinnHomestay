@model FinnHomestay.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold">🔐 Đăng Nhập</h4>
                <small class="text-white-50">Chào mừng bạn quay lại Finn Homestay</small>
            </div>
            <div class="card-body p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">📧</span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">🔑</span>
                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                            Đăng nhập
                        </button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted">Chưa có tài khoản?</span>
                        <a asp-action="Register" class="text-decoration-none fw-semibold">Đăng ký ngay</a>
                    </div>
                </form>

                <!-- Thẻ thông tin tài khoản demo cho đồ án -->
                <div class="card bg-light border-0 mt-4">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-2 text-primary">💡 Tài khoản mẫu kiểm thử đồ án:</h6>
                        <ul class="list-unstyled mb-0 small text-muted">
                            <li>👑 <strong>Admin:</strong> <code>admin@finnhomestay.com</code> / <code>123456</code></li>
                            <li>💼 <strong>Staff:</strong> <code>staff@finnhomestay.com</code> / <code>123456</code></li>
                            <li>👤 <strong>Customer:</strong> <code>customer@finnhomestay.com</code> / <code>123456</code></li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
