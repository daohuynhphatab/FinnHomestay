@model IEnumerable<FinnHomestay.Models.Booking>

@{
    bool isCustomer = User.IsInRole("Customer");
    ViewData["Title"] = isCustomer ? "Đơn Đặt Phòng Của Tôi" : "Quản lý Đơn Đặt Phòng";
    var statusFilter = ViewData["StatusFilter"]?.ToString();
    var searchString = ViewData["SearchString"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        @if (isCustomer)
        {
            <h2 class="fw-bold mb-1">📋 Đơn Đặt Phòng Của Bạn</h2>
            <p class="text-muted mb-0">Theo dõi trạng thái duyệt và thông tin các đơn đặt phòng bạn đã gửi</p>
        }
        else
        {
            <h2 class="fw-bold mb-1">📋 Quản lý Đơn Đặt Phòng (Staff / Admin)</h2>
            <p class="text-muted mb-0">Theo dõi, duyệt và quản lý tất cả các đơn đặt phòng tại Finn Homestay</p>
        }
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Đặt phòng mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ lọc và Tìm kiếm -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" class="form-control" 
                       placeholder="@(isCustomer ? "Nhập tên phòng cần tìm..." : "Nhập tên khách hàng hoặc tên phòng...")" 
                       value="@searchString" />
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <!option value="Pending" @(statusFilter == "Pending" ? "selected" : "")>Chờ duyệt (Pending)</!option>
                    <!option value="Confirmed" @(statusFilter == "Confirmed" ? "selected" : "")>Đã xác nhận (Confirmed)</!option>
                    <!option value="Cancelled" @(statusFilter == "Cancelled" ? "selected" : "")>Đã hủy (Cancelled)</!option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary">
                    🔍 Lọc & Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(searchString) || !string.IsNullOrEmpty(statusFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Booking -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <h5 class="fw-normal">Chưa có đơn đặt phòng nào</h5>
                <p class="mb-3">
                    @(isCustomer ? "Bạn chưa có đơn đặt phòng nào. Hãy khám phá và đặt phòng ngay nhé!" : "Hiện tại chưa có đơn đặt phòng nào trong hệ thống hoặc không tìm thấy kết quả phù hợp.")
                </p>
                <a asp-action="Create" class="btn btn-sm btn-primary">+ Đặt phòng ngay</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;" class="text-center">#Mã</th>
                            @if (!isCustomer)
                            {
                                <th>Khách hàng</th>
                            }
                            <th>Phòng</th>
                            <th class="text-center">Ngày Check-in</th>
                            <th class="text-center">Ngày Check-out</th>
                            <th>Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th style="width: 160px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var nights = (item.CheckOutDate.Date - item.CheckInDate.Date).Days;
                            if (nights <= 0) nights = 1;

                            <tr>
                                <td class="text-center text-muted fw-semibold">#@item.Id</td>
                                @if (!isCustomer)
                                {
                                    <td>
                                        <div class="fw-semibold">@(item.Customer?.FullName ?? "N/A")</div>
                                        @if (!string.IsNullOrEmpty(item.Customer?.Phone))
                                        {
                                            <small class="text-muted d-block">📞 @item.Customer.Phone</small>
                                        }
                                    </td>
                                }
                                <td>
                                    <div class="fw-semibold">@(item.Room?.Name ?? "N/A")</div>
                                    <small class="text-muted">@nights đêm</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        📅 @item.CheckInDate.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        📅 @item.CheckOutDate.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-success fw-bold">@item.TotalPrice.ToString("N0") VNĐ</span>
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">⏳ Chờ duyệt</span>
                                            break;
                                        case "Confirmed":
                                            <span class="badge bg-success px-3 py-2 rounded-pill">✔ Đã xác nhận</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger px-3 py-2 rounded-pill">✖ Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Xem hoặc chỉnh sửa đơn">
                                            @(isCustomer ? "Xem / Đổi" : "Sửa")
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn hủy/xóa đơn đặt phòng #@item.Id?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Hủy hoặc xóa đơn">
                                                @(isCustomer ? "Hủy" : "Xóa")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
