@model FinnHomestay.Models.Booking

@{
    ViewData["Title"] = "Tạo Đơn Đặt Phòng Mới";
    bool isCustomer = ViewBag.IsCustomer == true;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">➕ Tạo Đơn Đặt Phòng Mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="bookingForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Chọn Khách hàng (Ẩn nếu là Customer, Hiển thị nếu là Admin/Staff) -->
                    @if (isCustomer)
                    {
                        <input type="hidden" asp-for="CustomerId" />
                        <div class="mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-semibold text-muted mb-1">Khách hàng đặt phòng:</label>
                            <div class="fw-bold text-primary fs-5">👤 @(ViewBag.CustomerName ?? User.Identity?.Name)</div>
                            <small class="text-muted">Đơn đặt phòng này sẽ được liên kết trực tiếp với tài khoản cá nhân của bạn.</small>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Users" class="form-select">
                                <option value="">-- Chọn khách hàng --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                    }

                    <!-- Chọn Phòng -->
                    <div class="mb-3">
                        <label asp-for="RoomId" class="form-label fw-semibold"></label>
                        <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-select" id="roomSelect">
                            <option value="">-- Chọn phòng muốn đặt --</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger small"></span>
                    </div>

                    <!-- Ngày Check-in & Check-out -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CheckInDate" class="form-label fw-semibold"></label>
                            <input asp-for="CheckInDate" type="date" class="form-control" id="checkInDate" 
                                   value="@Model.CheckInDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CheckOutDate" class="form-label fw-semibold"></label>
                            <input asp-for="CheckOutDate" type="date" class="form-control" id="checkOutDate" 
                                   value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Tổng tiền & Gợi ý tự tính -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="TotalPrice" class="form-label fw-semibold mb-0"></label>
                            <span class="badge bg-light text-muted border" id="nightsBadge">1 đêm</span>
                        </div>
                        <div class="input-group">
                            <input asp-for="TotalPrice" class="form-control" type="number" step="1000" id="totalPriceInput" placeholder="Nhập hoặc để hệ thống tự động tính..." />
                            <span class="input-group-text">VNĐ</span>
                            <button class="btn btn-outline-secondary" type="button" id="btnAutoCalc" title="Tính tiền dựa trên giá phòng x số đêm">
                                ⚡ Tự tính
                            </button>
                        </div>
                        <span asp-validation-for="TotalPrice" class="text-danger small"></span>
                        <div class="form-text">Mẹo: Tổng tiền = Giá phòng/đêm × Số đêm lưu trú. Nếu để trống hoặc 0, hệ thống sẽ tự tính khi lưu.</div>
                    </div>

                    <!-- Trạng thái đơn đặt -->
                    @if (isCustomer)
                    {
                        <input type="hidden" asp-for="Status" value="Pending" />
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pending">Chờ duyệt (Pending) - Mặc định</option>
                                <option value="Confirmed">Đã xác nhận (Confirmed)</option>
                                <option value="Cancelled">Đã hủy (Cancelled)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            ← Quay lại danh sách
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            Lưu đơn đặt phòng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Dữ liệu giá phòng từ Controller
        const roomPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.RoomPriceMap ?? new Dictionary<string, decimal>()));

        const roomSelect = document.getElementById('roomSelect');
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');
        const totalPriceInput = document.getElementById('totalPriceInput');
        const nightsBadge = document.getElementById('nightsBadge');
        const btnAutoCalc = document.getElementById('btnAutoCalc');

        function calculateTotalPrice() {
            const roomId = roomSelect.value;
            const checkInVal = checkInInput.value;
            const checkOutVal = checkOutInput.value;

            if (!checkInVal || !checkOutVal) return;

            const checkIn = new Date(checkInVal);
            const checkOut = new Date(checkOutVal);

            const diffTime = checkOut.getTime() - checkIn.getTime();
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > 0) {
                nightsBadge.textContent = diffDays + ' đêm';
                const pricePerNight = roomPrices[roomId] || 0;
                if (pricePerNight > 0) {
                    totalPriceInput.value = diffDays * pricePerNight;
                }
            } else {
                nightsBadge.textContent = 'Ngày không hợp lệ';
            }
        }

        roomSelect.addEventListener('change', calculateTotalPrice);
        checkInInput.addEventListener('change', calculateTotalPrice);
        checkOutInput.addEventListener('change', calculateTotalPrice);
        btnAutoCalc.addEventListener('click', calculateTotalPrice);

        if (roomSelect.value) {
            calculateTotalPrice();
        }
    </script>
}
